# RehabBuddy Public Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit real secrets, API keys, service role keys, or patient data.

# Application environment mode: development | staging | production
VITE_APP_ENV=development

# Default UI language on initial load: en | hi
VITE_DEFAULT_LANGUAGE=en

# Future Supabase integration (owned by Person 2 - final 20% stage)
# Leave empty during offline-first / foundation stages.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
